{
  "name": "wuu-music",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "author": "mioolio",
  "description": "简洁现代化的音乐播放器",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/desktop.js start",
    "dev": "node scripts/desktop.js dev",
    "dev:desktop": "node scripts/desktop.js dev",
    "dev:mobile": "npm --prefix mobile_UI run dev",
    "dev:all": "node scripts/dev.js",
    "build:desktop": "node scripts/desktop.js build",
    "build:mobile": "npm --prefix mobile_UI run build",
    "build:full": "node scripts/build.js run",
    "build": "node scripts/build.js package",
    "build:dir": "node scripts/build.js dir",
    "typecheck": "npm --prefix desktop_UI run typecheck",
    "test": "npm --prefix desktop_UI test && npm --prefix mobile_UI test && node --test audio/library-startup.test.cjs && node --test server/song-identity.test.cjs && node --test renderer/tests/shuffle.cjs && node scripts/together-state.cjs && node scripts/classic-preview-lyrics.cjs",
    "test:mobile": "npm --prefix mobile_UI test",
    "test:mobile-ui": "node scripts/mobile-lyrics.cjs",
    "test:mobile-appearance": "node scripts/mobile-appearance.cjs",
    "test:together": "node scripts/together-state.cjs",
    "test:together-ui": "node scripts/together-desktop.cjs",
    "test:classic-preview": "node scripts/classic-preview-lyrics.cjs",
    "test:song-identity": "node --test server/song-identity.test.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:visual": "node scripts/visual-desktop.cjs",
    "test:player-polish": "node scripts/player-polish.cjs",
    "test:desktop-lyrics": "node scripts/desktop-lyrics-motion.cjs",
    "test:motion": "node scripts/motion-desktop.cjs",
    "test:reading": "node scripts/reading-desktop.cjs",
    "test:previous": "node scripts/previous-desktop.cjs",
    "test:titlebar": "node scripts/titlebar-desktop.cjs",
    "test:apple": "node scripts/titlebar-desktop.cjs --apple",
    "test:frosted": "node --test window/frosted-glass.test.cjs && node scripts/frosted-desktop.cjs",
    "test:startup": "node scripts/startup-desktop.cjs",
    "test:scanner": "node --test audio/library-startup.test.cjs",
    "test:detail": "node scripts/detail-desktop.cjs",
    "postinstall": "node scripts/patch-kugoumusicapi.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "axios": "^1.2.2",
    "crypto-js": "^4.2.0",
    "express": "^4.17.1",
    "express-fileupload": "^1.1.9",
    "jpeg-js": "^0.4.4",
    "md5": "^2.3.0",
    "music-metadata": "^11.16.0",
    "node-forge": "^1.3.1",
    "pac-proxy-agent": "^7.0.0",
    "qrcode": "^1.4.4",
    "safe-decode-uri-component": "^1.2.1",
    "sql.js": "^1.12.0",
    "tunnel": "^0.0.6",
    "ws": "^8.21.3",
    "xml2js": "^0.6.2",
    "yargs": "^17.1.1",
    "kugoumusicapi": "file:vendor/kugoumusicapi"
  },
  "build": {
    "appId": "com.wuu.music",
    "productName": "Wuu Music",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "audio/**/*",
      "soda/**/*",
      "cover/**/*",
      "window/**/*",
      "download/**/*",
      "repair/**/*",
      "free-music/**/*",
      "kugou/**/*",
      "qishui/**/*",
      "server/**/*",
      "playlist/**/*",
      "desktop_UI/dist/**/*",
      "renderer/**/*",
      "netease/**/*",
      "tools/netease-api/**/*",
      "!tools/netease-api/node_modules/**/*",
      "parsers/**/*",
      "mobile_UI/dist/**/*",
      "music-dl.exe",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "parsers/qishui-decrypt/native/**"
    ],
    "extraResources": [
      {
        "from": "config/",
        "to": "config/",
        "filter": [
          "*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
